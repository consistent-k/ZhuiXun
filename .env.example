# 复制为 .env 后填写真实值（.env 已被 gitignore，切勿提交）

# 模型服务（可选，不填则由前端设置界面传入）
# MODEL_PROVIDER=openai
# MODEL_BASE_URL=https://api.openai.com/v1
# MODEL_API_KEY=
# MODEL_NAME=gpt-4

# 日志系统（均可选，留空即用下方默认值；时间戳统一为东八区 UTC+8）
# 输出阈值 error|warn|info|debug，留空=dev:debug / prod:info
# LOG_LEVEL=
# 是否落盘到文件，留空=dev 仅 console / prod 落盘；true|false 可显式覆盖
# LOG_TO_FILE=
# 日志目录，留空=~/.zhuixun/logs
# LOG_DIR=
# 单文件大小上限(MB)，超限滚动为带时间戳的备份
# LOG_MAX_FILE_MB=10
# 日志保留天数，过期自动清理
# LOG_RETENTION_DAYS=7
# 控制台输出形态 pretty|json，留空=dev:pretty / prod:json
# LOG_FORMAT=

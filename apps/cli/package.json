{
    "name": "@zhuixun/cli",
    "version": "2.0.0",
    "description": "追寻 terminal client",
    "type": "module",
    "bin": {
        "zhuixun": "./dist/cli.js"
    },
    "files": [
        "dist"
    ],
    "engines": {
        "node": ">=24"
    },
    "scripts": {
        "build": "pnpm --filter @zhuixun/backend bundle && node build.mjs",
        "start": "node dist/cli.js",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@ai-sdk/react": "^4.0.177",
        "@vscode/ripgrep": "^1.18.0",
        "ai": "^7.0.173",
        "ink": "^8.0.0",
        "marked": "18.2.0",
        "qrcode-terminal": "^0.12.0",
        "react": "^19.3.1",
        "string-width": "9.0.0"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@types/qrcode-terminal": "^0.12.2",
        "@types/react": "^19.2.18",
        "@zhuixun/i18n": "workspace:*",
        "esbuild": "^0.28.2"
    }
}

{
    "name": "@zhuixun/backend",
    "version": "0.1.0",
    "type": "module",
    "scripts": {
        "dev": "node --watch --import tsx src/index.ts",
        "build": "tsc --noEmit",
        "build:tsc": "tsc --noEmit",
        "bundle": "tsup",
        "bundle:watch": "tsup --watch",
        "start": "node --import tsx src/index.ts",
        "typecheck": "tsc --noEmit",
        "typecheck:test": "tsc --noEmit -p test/tsconfig.json",
        "test": "vitest run",
        "test:unit": "vitest run test/unit",
        "test:integration": "vitest run test/integration",
        "test:http": "vitest run test/http",
        "test:contract": "vitest run --config vitest.contract.config.ts test/contract",
        "test:watch": "vitest",
        "test:coverage": "vitest run --coverage"
    },
    "dependencies": {
        "@ai-sdk/anthropic": "^4.0.105",
        "@ai-sdk/google": "4.0.124",
        "@ai-sdk/mcp": "^2.0.99",
        "@ai-sdk/openai": "^4.0.118",
        "@ai-sdk/openai-compatible": "^3.0.92",
        "@ai-sdk/provider": "^4.0.38",
        "@ai-sdk/provider-utils": "^5.0.81",
        "@hono/node-server": "^2.1.8",
        "@modelcontextprotocol/sdk": "^1.32.2",
        "@vscode/ripgrep": "^1.18.0",
        "@zhuixun/channels-core": "workspace:*",
        "@zhuixun/shared": "workspace:*",
        "ai": "^7.0.173",
        "bash-tool": "^1.3.19",
        "csv-parse": "^7.0.3",
        "dayjs": "^1.11.23",
        "exceljs": "^4.4.0",
        "fflate": "^0.8.3",
        "gray-matter": "^4.0.3",
        "hono": "^4.13.18",
        "iconv-lite": "0.7.3",
        "just-bash": "file:./scripts/just-bash-stub",
        "mammoth": "^1.13.0",
        "node-html-markdown": "^2.0.0",
        "yaml": "^2.9.1",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@types/node": "^26.6.6",
        "@vitest/coverage-v8": "^5.1.0",
        "esbuild": "^0.28.2",
        "tsup": "^9.0.0",
        "tsx": "^4.7.0",
        "typescript": "~6.0.2",
        "vitest": "^5.1.0"
    }
}

{
    "name": "@zhuixun/desktop",
    "private": true,
    "version": "2.0.0",
    "description": "追寻 - 通用桌面 AI 智能工作台",
    "author": "consistent-k",
    "type": "module",
    "main": "dist-electron/main.js",
    "scripts": {
        "dev": "vite",
        "dev:web": "WEB_ONLY=1 vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc -b --force",
        "package": "pnpm build && electron-builder",
        "package:mac": "pnpm build && electron-builder --mac",
        "package:mac:universal": "pnpm build && electron-builder --mac --universal",
        "package:win": "pnpm build && electron-builder --win --x64",
        "package:all": "pnpm build && electron-builder --mac --win"
    },
    "dependencies": {
        "@zhuixun/shared": "workspace:*",
        "dayjs": "^1.11.23",
        "electron-updater": "^6.8.11"
    },
    "devDependencies": {
        "@ai-sdk/react": "^4.0.177",
        "@ant-design/icons": "^6.3.4",
        "@ant-design/x": "^2.10.0",
        "@ant-design/x-markdown": "^2.10.0",
        "@types/node": "^26.6.6",
        "@types/react": "^19.2.18",
        "@types/react-dom": "^19.2.4",
        "@vitejs/plugin-react": "^6.3.0",
        "ahooks": "^3.11.0",
        "ai": "^7.0.173",
        "antd": "^6.7.0",
        "antd-style": "^4.1.0",
        "axios": "^1.21.1",
        "electron": "^45.3.1",
        "electron-builder": "^26.18.0",
        "html2canvas": "^1.4.1",
        "jspdf": "^4.2.1",
        "jspdf-autotable": "^5.0.9",
        "marked": "^18.2.0",
        "pdfjs-dist": "^6.5.438",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "react-router": "^8.5.1",
        "typescript": "~7.0.2",
        "use-stick-to-bottom": "^1.1.6",
        "vite": "^8.3.8",
        "vite-plugin-electron": "^1.2.0",
        "zustand": "^5.1.0"
    }
}
